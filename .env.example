# ─────────────────────────────────────────────────────────────────────────────
# Parkio Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=8080

# Database (PostgreSQL/PostGIS)
# Use localhost when the app runs directly on the host.
# Docker Compose overrides this with jdbc:postgresql://db:5432/parkio.
DB_URL=jdbc:postgresql://localhost:5432/parkio
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_POOL_SIZE=10

# JWT  — generate with: openssl rand -base64 32
JWT_SECRET=replace_with_256_bit_base64_secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Admin seed user
ADMIN_EMAIL=admin@parkio.com
ADMIN_PASSWORD=YourSecureAdminPass1!
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin

# Email / SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yelisomahe@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=noreply@parkio.com

# Frontend (used in password reset links)
FRONTEND_URL=https://app.parkio.com

# CORS
CORS_ALLOWED_ORIGINS=https://app.parkio.com

# Payment
PAYMENT_GATEWAY=simulated   # set to: paystack | stripe for production
PAYMENT_CURRENCY=GHS

# Redis
# Use localhost when the app runs directly on the host.
# Docker Compose overrides this with redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
TOKEN_BLACKLIST_STORE=memory
BOOKING_LOCK_ENABLED=false

# SMS / OTP
SMS_PROVIDER=none
OTP_DEV_MODE=true
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
HUBTEL_SMS_SENDER_ID=Parkio

# Paystack (required when PAYMENT_GATEWAY=paystack)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
